# ====== SUPABASE (majburiy) ======
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Faqat serverda ishlatiladi (cron, AI navbat, provayder holati). Brauzerga chiqmaydi.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ====== AI PROVAYDERLAR (bepul, kamida bittasi yetarli) ======
# Ketma-ketlik: AI_PROVIDER_ORDER bo'yicha. Limit tugasa keyingisiga o'tadi,
# hammasi tugasa — AI'siz rejim (kesh + oflayn mashqlar) va navbat.
AI_PROVIDER_ORDER=groq,gemini,cerebras,openrouter,mistral

# Groq  — https://console.groq.com/keys  (bepul, juda tez)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini — https://aistudio.google.com/apikey (bepul tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Cerebras — https://cloud.cerebras.ai (bepul tier)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

# OpenRouter — https://openrouter.ai/keys (":free" modellar bepul)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Mistral — https://console.mistral.ai (bepul "Experiment" rejasi)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ====== CRON (Vercel Cron → /api/cron/daily) ======
# Tasodifiy uzun satr. Vercel → Settings → Environment Variables ga ham qo'shing.
CRON_SECRET=change-me-to-a-long-random-string

# ====== SAYT ======
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Köprü
